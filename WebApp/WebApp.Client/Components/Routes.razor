@using System.Reflection
<Router AppAssembly="@AppAssembly" AdditionalAssemblies="new[] { typeof(Client._Imports).Assembly }">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(EmptyBaseLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
@code {
    [Parameter]
    public Assembly AppAssembly { get; set; }
}